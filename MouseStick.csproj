<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>MouseStick</AssemblyName>
    <RootNamespace>MouseStick</RootNamespace>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Version>1.0.0</Version>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>

    <!-- Override on the command line if VTOL VR lives elsewhere: -p:GameDir="D:\SteamLibrary\steamapps\common\VTOL VR" -->
    <GameDir Condition="'$(GameDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\VTOL VR</GameDir>
    <GameManaged>$(GameDir)\VTOLVR_Data\Managed</GameManaged>
    <LoaderManaged>$(GameDir)\Managed</LoaderManaged>
    <!-- Local mods folder the mod loader scans for item.json -->
    <DeployDir>$(GameDir)\@Mod Loader\Mods\MouseStick</DeployDir>
    <DeployToGame Condition="'$(DeployToGame)' == ''">true</DeployToGame>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Assembly-CSharp"><HintPath>$(GameManaged)\Assembly-CSharp.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine"><HintPath>$(GameManaged)\UnityEngine.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(GameManaged)\UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.IMGUIModule"><HintPath>$(GameManaged)\UnityEngine.IMGUIModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.InputLegacyModule"><HintPath>$(GameManaged)\UnityEngine.InputLegacyModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.TextRenderingModule"><HintPath>$(GameManaged)\UnityEngine.TextRenderingModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.UI"><HintPath>$(GameManaged)\UnityEngine.UI.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Unity.TextMeshPro"><HintPath>$(GameManaged)\Unity.TextMeshPro.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.UIModule"><HintPath>$(GameManaged)\UnityEngine.UIModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.JSONSerializeModule"><HintPath>$(GameManaged)\UnityEngine.JSONSerializeModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="ModLoader.Framework"><HintPath>$(LoaderManaged)\ModLoader.Framework.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="0Harmony"><HintPath>$(LoaderManaged)\0Harmony.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>

  <ItemGroup>
    <None Include="item.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="README.md" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="DeployMod" AfterTargets="Build" Condition="'$(DeployToGame)' == 'true' And Exists('$(GameDir)\VTOLVR.exe')">
    <MakeDir Directories="$(DeployDir)" />
    <Copy SourceFiles="$(TargetDir)MouseStick.dll;$(TargetDir)MouseStick.pdb;$(TargetDir)item.json" DestinationFolder="$(DeployDir)" />
    <Message Importance="high" Text="MouseStick deployed to $(DeployDir)" />
  </Target>

</Project>
